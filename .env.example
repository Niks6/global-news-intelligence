# ============================================================
# Global News Intelligence Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Cluster Nodes (LAN IPs or hostnames) ---
NODE1_HOST=192.168.1.101
NODE2_HOST=192.168.1.102
NODE3_HOST=192.168.1.103

# Human-readable hostnames (add to /etc/hosts or Windows hosts file)
NODE1_HOSTNAME=node1
NODE2_HOSTNAME=node2
NODE3_HOSTNAME=node3

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=node1:9092
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://node1:9092
KAFKA_ZOOKEEPER_CONNECT=node1:2181,node2:2181,node3:2181
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=10737418240
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_MAX_POLL_RECORDS=500
# Topic names
KAFKA_TOPIC_EVENTS_RAW=gdelt.events.raw
KAFKA_TOPIC_MENTIONS_RAW=gdelt.mentions.raw
KAFKA_TOPIC_GKG_RAW=gdelt.gkg.raw
KAFKA_TOPIC_EVENTS_NORMALIZED=gdelt.events.normalized
KAFKA_TOPIC_ANALYTICS=gdelt.analytics
KAFKA_TOPIC_DEAD_LETTER=gdelt.dead-letter

# --- ZooKeeper ---
ZOOKEEPER_CONNECT=node1:2181,node2:2181,node3:2181
ZOOKEEPER_CLIENT_PORT=2181

# --- Hadoop HDFS ---
HDFS_NAMENODE_HOST=node3
HDFS_NAMENODE_PORT=8020
HDFS_NAMENODE_URI=hdfs://node3:8020
HDFS_REPLICATION_FACTOR=2
HDFS_BLOCK_SIZE=134217728
# HDFS paths
HDFS_ROOT=/gdelt
HDFS_RAW_PATH=/gdelt/raw
HDFS_CURATED_PATH=/gdelt/curated
HDFS_ANALYTICS_PATH=/gdelt/analytics
HDFS_CHECKPOINTS_PATH=/gdelt/checkpoints

# --- HBase ---
HBASE_ZOOKEEPER_QUORUM=node1,node2,node3
HBASE_ZOOKEEPER_PORT=2181
HBASE_MASTER_HOST=node3
HBASE_MASTER_PORT=16000
HBASE_REST_PORT=8080

# --- Spark ---
SPARK_MASTER_URL=spark://node2:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_DEFAULT_PARALLELISM=6
SPARK_CHECKPOINT_DIR=/gdelt/checkpoints/spark

# --- GDELT Ingestion ---
GDELT_MASTER_LIST_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt
GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2/
GDELT_POLL_INTERVAL_SECONDS=900
GDELT_DOWNLOAD_TIMEOUT_SECONDS=120
GDELT_MAX_RETRIES=5
GDELT_RETRY_BACKOFF_BASE=2
# Local paths for raw/processed data
GDELT_RAW_DATA_DIR=./data/raw
GDELT_PROCESSED_DATA_DIR=./data/processed
GDELT_CHECKPOINT_FILE=./data/processed/.ingestion_checkpoint.json

# --- GDELT DOC API (supplementary, rate-limited) ---
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_DOC_API_RATE_LIMIT_RPM=1
GDELT_DOC_API_MAX_CONCURRENT=1

# --- FastAPI Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://node1:3000
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO
BACKEND_API_PREFIX=/api
BACKEND_MAX_PAGE_SIZE=200
BACKEND_DEFAULT_PAGE_SIZE=50
BACKEND_MAX_TIME_RANGE_DAYS=365

# --- React Frontend ---
REACT_APP_API_BASE_URL=http://node1:8000/api
REACT_APP_ENV=production

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# --- Security ---
# Add a strong secret for any JWT/session use if added later
# SECRET_KEY=change-me-use-a-long-random-string

# --- Development mode overrides ---
# Set DEV_MODE=true to use Docker Compose Kafka instead of cluster
DEV_MODE=false
# Docker Compose Kafka (used when DEV_MODE=true)
DEV_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DEV_ZOOKEEPER_CONNECT=localhost:2181
