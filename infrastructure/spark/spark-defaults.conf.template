# Spark Configuration Template for GDELT streaming on 8GB machines
# Copy to $SPARK_HOME/conf/spark-defaults.conf
# Conservative settings tuned for academic 3-PC cluster

spark.master                     spark://<SPARK_MASTER_HOST>:7077
spark.driver.memory              2g
spark.executor.memory            2g
spark.executor.cores             2
spark.default.parallelism        6
spark.sql.shuffle.partitions     6

# Structured Streaming
spark.sql.streaming.checkpointLocation   /gdelt/checkpoints
spark.sql.streaming.schemaInference      true

# Kafka connector
spark.jars.packages              org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1

# Serialization
spark.serializer                 org.apache.spark.serializer.KryoSerializer
spark.kryoserializer.buffer.max  256m

# Memory management
spark.memory.fraction            0.6
spark.memory.storageFraction     0.5
spark.sql.adaptive.enabled       true

# Network
spark.network.timeout            300s
spark.rpc.askTimeout             300s

# UI
spark.ui.port                    4040

# Conservative GC
spark.executor.extraJavaOptions  -XX:+UseG1GC -XX:MaxGCPauseMillis=200
spark.driver.extraJavaOptions    -XX:+UseG1GC -XX:MaxGCPauseMillis=200

