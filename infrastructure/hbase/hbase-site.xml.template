<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  HBase site configuration for 3-node academic cluster.
  Copy to $HBASE_HOME/conf/hbase-site.xml on ALL nodes.
  Replace <NAMENODE_HOST> with Machine 3 hostname/IP.
  Replace <ZOOKEEPER_HOST> with Machine 3 hostname/IP (or comma-separated list for multi-ZK).
-->
<configuration>
  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>
  <property>
    <name>hbase.rootdir</name>
    <value>hdfs://<NAMENODE_HOST>:9000/hbase</value>
    <description>HBase data stored in HDFS</description>
  </property>
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value><ZOOKEEPER_HOST></value>
    <description>ZooKeeper quorum. For single ZK: one hostname.
    For 3-node ZK quorum: host1,host2,host3</description>
  </property>
  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.dataDir</name>
    <value>/var/hbase/zookeeper</value>
  </property>
  <property>
    <name>hbase.master.port</name>
    <value>16000</value>
  </property>
  <property>
    <name>hbase.master.info.port</name>
    <value>16010</value>
  </property>
  <property>
    <name>hbase.regionserver.port</name>
    <value>16020</value>
  </property>
  <property>
    <name>hbase.regionserver.info.port</name>
    <value>16030</value>
  </property>
  <!-- Thrift server for Python happybase client -->
  <property>
    <name>hbase.thrift.port</name>
    <value>9090</value>
  </property>
  <!-- Conservative heap for 8 GB machines -->
  <!-- Set in hbase-env.sh:
    export HBASE_MASTER_OPTS="-Xmx512m"
    export HBASE_REGIONSERVER_OPTS="-Xmx1g"
  -->
</configuration>

